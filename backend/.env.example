# 本地开发环境变量示例（复制为 .env 后按需修改；真实环境变量不提交代码库）

# 应用名称
APP_NAME=OpenGantt

# 数据库连接：默认使用本地 SQLite 文件，零配置
# 服务器如需 PostgreSQL（免费开源），取消注释并替换：
# DATABASE_URL=postgresql+psycopg://opengantt:opengantt@db:5432/opengantt
# DATABASE_URL=sqlite:///data/opengantt.db

# 跨域来源：开发环境为 Vite/预览地址；生产同源部署可改为你的域名
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# ---- 认证 ----
# JWT 签名密钥：生产环境务必通过环境变量显式设置（随机长字符串）；
# 未设置时本地会自动生成并保存在 data/.jwt_secret
# JWT_SECRET=change-me-to-a-long-random-string
# 令牌有效期（天）
TOKEN_EXPIRE_DAYS=7
# 内置管理员初始账号（仅首次启动种子时创建，生产部署后请立即登录修改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- 进度文档上传 ----
# 上传大小限制（MB）
MAX_UPLOAD_MB=20

# 是否由后端托管前端构建产物（一体化部署设为 true）
SERVE_FRONTEND=true

# 前端构建产物目录（相对 backend 目录）
FRONTEND_DIST=../frontend/dist

# 首次启动是否写入演示数据
SEED_DEMO_DATA=true
